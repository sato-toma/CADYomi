{
    "name": "cadyomi",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 0.0.0.0",
        "typecheck": "tsc -b --pretty false",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "vitest run src/step.smoke.test.ts",
        "test:e2e": "node scripts/run-step-fixture-test.mjs",
        "test:step": "npm run test:e2e"
    },
    "dependencies": {
        "occt-import-js": "^0.0.23",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "typescript": "^7.0.0",
        "vite": "^8.3.0",
        "vitest": "^3.2.4"
    }
}
