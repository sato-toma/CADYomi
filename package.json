{
    "name": "cadyomi",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "build:desktop": "npm run build && electron-builder --win",
        "desktop": "electron .",
        "cap:sync": "npm run build && cap sync",
        "android:add": "cap add android",
        "android:open": "cap open android",
        "android:build": "npm run cap:sync && cap build android",
        "preview": "vite preview --host 0.0.0.0",
        "typecheck": "tsc -b --pretty false",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "verify:occt": "node scripts/verify-occt-binding.mjs",
        "test": "vitest run src/step.smoke.test.ts",
        "test:e2e": "node scripts/run-step-fixture-test.mjs",
        "test:step": "npm run test:e2e"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "occt-import-js": "^0.0.23",
        "opencascade.js": "1.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "three": "^0.186.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@capacitor/cli": "^8.5.2",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.1",
        "electron": "^44.4.3",
        "electron-builder": "^26.15.3",
        "typescript": "^7.0.0",
        "vite": "^8.3.0",
        "vitest": "^3.2.4"
    },
    "build": {
        "appId": "com.cadyomi.inspector",
        "productName": "CADYomi",
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
