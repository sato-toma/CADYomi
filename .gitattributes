# Default: auto-detect text files and normalize to LF in the repository
* text=auto

# Source and config files: keep LF in the repo for consistency across platforms
*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html,htm,md,mdx,yml,yaml,xml,svg,txt,sql,ini,env,sh} text eol=lf

# Windows shell and script files: use CRLF for native Windows behavior
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf

# Binary files: never convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Common generated or packaged artifacts
*.min.js -text
*.min.css -text
